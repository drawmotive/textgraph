{
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "stage": {
            "enum": [
              "parse",
              "semantic",
              "layout",
              "render",
              "font"
            ]
          },
          "message": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "line",
              "column"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "severity",
          "stage",
          "message"
        ],
        "additionalProperties": true
      }
    },
    "success": {
      "type": "boolean"
    },
    "png": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "protocolVersion",
    "success",
    "diagnostics"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "png",
          "width",
          "height"
        ],
        "properties": {
          "diagnostics": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "severity": {
                    "const": "error"
                  }
                }
              }
            },
            "type": "array"
          },
          "png": {},
          "width": {},
          "height": {}
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "png"
              ],
              "properties": {
                "png": {}
              }
            },
            {
              "required": [
                "width"
              ],
              "properties": {
                "width": {}
              }
            },
            {
              "required": [
                "height"
              ],
              "properties": {
                "height": {}
              }
            }
          ]
        },
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
