{
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "valid": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "stage": {
            "enum": [
              "parse",
              "semantic"
            ]
          },
          "message": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "line",
              "column"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "severity",
          "stage",
          "message"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "protocolVersion",
    "valid",
    "diagnostics"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
